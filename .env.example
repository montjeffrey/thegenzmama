# Copy to .env.local and fill in. Never commit real values.

# Sanity (public by design: they ship in the browser bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=

# Browser-side keys (public by design; restrict the Maps key to this site's referrers)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side secrets: set in Netlify, never prefix with NEXT_PUBLIC_
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_EMAIL=

# Only for `node scripts/seed-sanity.js` on your own machine. An Editor-scoped
# write token: keep it in .env.local, do NOT set it in Netlify, and revoke it in
# the Sanity project's API settings once seeding is done.
SANITY_API_WRITE_TOKEN=
